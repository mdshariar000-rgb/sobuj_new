<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight export, signed with the client's (Green Shelter)
	     Apple Distribution certificate and "Shobuj App Store" profile. Used by
	     `flutter build ipa --export-options-plist=ios/ExportOptions.plist`. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>XCGZVG9PT7</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.greenshelter.shobuj</key>
		<string>Shobuj App Store</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
